# ==========================================================
# Job Market Intelligence & Skill Analytics Platform
# .env.example
#
# PURPOSE:
#   This file shows the environment variables this project WILL use.
#   It contains PLACEHOLDERS ONLY - no real passwords, keys, or tokens.
#
# HOW TO USE (never commit the real .env file):
#   1. Copy this file:      cp .env.example .env   (Windows: copy .env.example .env)
#   2. Open .env and replace the placeholders with your own local values.
#   3. .env is already listed in .gitignore, so it will never be pushed to GitHub.
# ==========================================================

# ------------------------------------------------------------
# Application settings
# ------------------------------------------------------------
APP_NAME=job-market-intelligence
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # true | false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------
# PostgreSQL - Python data-access layer (src/data/database.py)
# ------------------------------------------------------------
# These are the ONLY variables the Python code reads.
# Leave DB_PASSWORD empty here and put the real password in .env,
# which is already excluded by .gitignore.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here

# ------------------------------------------------------------
# PostgreSQL - local development (Docker Compose)
# Not used by src/data/. Kept for a later containerised stage.
# ------------------------------------------------------------
POSTGRES_DB=job_market
POSTGRES_USER=your_local_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# PostgreSQL - AWS RDS / production (use placeholders for now)
# ------------------------------------------------------------
AWS_REGION=ap-south-1
RDS_INSTANCE_IDENTIFIER=your-rds-instance
RDS_DB_NAME=job_market
RDS_USERNAME=your_rds_username
RDS_PASSWORD=your_password_here
RDS_HOST=your-rds-endpoint
RDS_PORT=5432

# ------------------------------------------------------------
# AWS credentials - DO NOT put real keys here.
# Use environment variables, the AWS CLI profile, or IAM roles instead.
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_token_here

# ------------------------------------------------------------
# AWS S3 - raw and processed data storage
# ------------------------------------------------------------
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_RAW_PREFIX=raw/
AWS_S3_PROCESSED_PREFIX=processed/

# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_PREFIX=/api/v1

# ------------------------------------------------------------
# Streamlit
# ------------------------------------------------------------
STREAMLIT_PORT=8500
STREAMLIT_THEME=light

# ------------------------------------------------------------
# Data source (Phase 2 - placeholders only, no real tokens)
# ------------------------------------------------------------
DATA_SOURCE=dataset_file            # dataset_file | public_api
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
JOB_API_BASE_URL=https://example.invalid/api
JOB_API_KEY=your_api_key_here

# ------------------------------------------------------------
# Machine learning (Phase 6)
# ------------------------------------------------------------
ML_MODEL_PATH=artifacts/models
ML_RANDOM_STATE=42
ML_TEST_SIZE=0.2

# ------------------------------------------------------------
# Monitoring (Phase 10)
# ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_password_here

# ------------------------------------------------------------
# AWS CloudWatch / general logging
# ------------------------------------------------------------
LOG_GROUP_NAME=/aws/job-market-intelligence
AWS_ACCESS_KEY_ID_PLACEHOLDER=
